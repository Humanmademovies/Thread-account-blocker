{
  "manifest_version": 3,
  "name": "blockedex",
  "version": "0.2.1",
  "description": "Importez, appliquez et exportez des listes de blocage sur Threads.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.threads.com/*",
    "https://threads.com/*",
    "https://www.threads.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Ouvrir blockedex" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
